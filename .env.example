# Environment Variables
# Copy this file to .env.local and fill in the values

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_knowledge_platform?schema=public"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"

# OAuth Providers (optional - configure at least one)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# AI Providers (configure at least one)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""
GROQ_API_KEY=""
MISTRAL_API_KEY=""
DEEPSEEK_API_KEY=""

# Default AI Provider
DEFAULT_AI_PROVIDER="openai"

# Vector Database (optional - defaults to in-memory)
VECTOR_DB_TYPE="memory"
PINECONE_API_KEY=""
PINECONE_INDEX_NAME=""
QDRANT_URL=""
QDRANT_API_KEY=""

# File Upload
MAX_FILE_SIZE_MB="10"

# Rate Limiting
RATE_LIMIT_REQUESTS="100"
RATE_LIMIT_WINDOW_MS="60000"

# App Settings
NEXT_PUBLIC_APP_NAME="AI Knowledge Platform"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
